#!/usr/bin/env bash
set -euo pipefail

# What is this?
#   Print basic system information.
#
# Usage:
#   $ ./proper7y
#
# Prerequisites:
#     Bash version >= 4.0
#
# Supported Software:
#     For the list of supported OS, virtualization environments, and shells,
#     see the "Support policy" section in README.md:
#     https://github.com/rnazmo/proper7y/blob/main/README.md#support-policy
#
#     The actual supported values are defined in the following global variables:
#         OS:             SUPPORTED_OS_IDS
#         Virtualization: SUPPORTED_VIRTUALIZATION_IDS
#         Shell:          SUPPORTED_SHELL_IDS

# -------------------------------------------------------------------

readonly PROPER7Y_VERSION="v0.10.1"

# 'declare -l' is intentional: it forces values to lowercase on assignment,
# so that case-statement comparisons (e.g. 'linux', 'physical') always work
# regardless of what uname or other commands return (e.g. 'Linux', 'Darwin').
# Note: UNAME_CACHE_MACHINE and UNAME_CACHE_RELEASE are also declared with -l
# because they come from the same uname call; their values happen to be
# lowercase already, but -l makes this explicit and future-proof.
declare -l UNAME_CACHE_KERNEL_NAME="This_value_should_be_overridden"
declare -l UNAME_CACHE_MACHINE="This_value_should_be_overridden"
declare -l UNAME_CACHE_RELEASE="This_value_should_be_overridden"

declare -l OS_FAMILY_ID="This_value_should_be_overridden"
declare -l OS_ID="This_value_should_be_overridden"
declare -l VIRTUALIZATION_ID="This_value_should_be_overridden"
declare -l CHASSIS_ID="This_value_should_be_overridden"
declare -l CURRENT_SHELL_ID="This_value_should_be_overridden"

declare -al SUPPORTED_OS_FAMILY_IDS=( # Allowed OS_FAMILY_ID values
  "arch-based"
  "debian-based"
  "darwin-based"
)
declare -al SUPPORTED_OS_IDS=( # Allowed OS_ID values
  "archlinux"
  "endeavouros"
  "manjaro"
  "debian"
  "kali"
  "ubuntu"
  "macos"
)
# Ref: https://man.archlinux.org/man/systemd-detect-virt.1.en
declare -al SUPPORTED_VIRTUALIZATION_IDS=( # Allowed VIRTUALIZATION_ID values
  "virtualbox"
  "vmware"
  "microsoft" # Used in GitHub Actions
  "docker"
  "wsl"
  "applehv"    # Apple Hypervisor-based VM (vendor unknown)
  "generic-vm" # VM confirmed but hypervisor vendor unknown
  "physical"   # It's not a virtualized environment but a physical hardware.
  "unknown"
)
declare -al SUPPORTED_SHELL_IDS=( # Allowed SHELL_ID values
  "bash"
  "zsh"
  "unknown"
)

declare -al SUPPORTED_CHASSIS_IDS=( # Allowed CHASSIS_ID values (Ref: systemd machine-info)
  "desktop"
  "laptop"
  "server"
  "tablet"
  "handset"
  "watch"
  "embedded"
  "vm"
  "container"
  "unknown"
  "n/a" # Used when chassis type is not applicable (e.g. in virtualized environments)
)

declare -A OS_NAMES=( # The key is OS_ID
  ["archlinux"]="Arch Linux"
  ["endeavouros"]="EndeavourOS"
  ["manjaro"]="Manjaro"
  ["debian"]="Debian"
  ["kali"]="Kali Linux"
  ["ubuntu"]="Ubuntu"
  ["macos"]="macOS"
)
declare -A VIRTUALIZATION_NAMES=( # The key is VIRTUALIZATION_ID
  ["virtualbox"]="VirtualBox"
  ["vmware"]="VMware"
  ["microsoft"]="Hyper-V"
  ["docker"]="Docker"
  ["wsl"]="WSL"
  ["applehv"]="Apple Hypervisor VM"
  ["generic-vm"]="Virtual Machine"
  ["physical"]="Physical"
  ["unknown"]="Unknown"
)
declare -A SHELL_NAMES=( # The key is SHELL_ID
  ["bash"]="Bash"
  ["zsh"]="Zsh"
  ["unknown"]="Unknown"
)
declare -A CHASSIS_NAMES=( # The key is CHASSIS_ID
  ["desktop"]="Desktop"
  ["laptop"]="Laptop"
  ["server"]="Server"
  ["tablet"]="Tablet"
  ["handset"]="Handset"
  ["watch"]="Watch"
  ["embedded"]="Embedded"
  ["vm"]="Virtual Machine"
  ["container"]="Container"
  ["unknown"]="Unknown"
  ["n/a"]="N/A"
)

# -------------------------------------------------------------------

# Must be called once at the very beginning of the script.
#
# Called by the BASH_SOURCE guard (end of this file) before main().
# When this file is sourced for testing (e.g. via bats), init() is
# intentionally not executed so that individual functions can be tested
# without side effects.
init() {
  check_prerequisites
  identify_environment # Exits here if the OS or environment is not supported.
}

# Check that the runtime meets the minimum requirements for this script.
# Exit immediately if requirements are not satisfied.
check_prerequisites() {
  if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
    log_err "Must be Bash version >= 4.0."
    log_debug "Bash version: ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"
    exit 1
  fi
}

# Identify the current environment (OS, virtualization, shell).
# Exit immediately if the environment is not supported.
identify_environment() {
  cache_uname

  identify_os_family_id
  identify_os_id
  identify_virtualization_id
  identify_chassis_id
  identify_current_shell_id
}

# -------------------------------------------------------------------

# Print all system information fields.
#
# NOTE: init() must have been called before this function is invoked.
# This is guaranteed by the BASH_SOURCE guard at the bottom of the file.
# When testing individual print_*() functions via 'source', init() is
# skipped and global variables are set directly by the test.
main() {
  echo "proper7y $PROPER7Y_VERSION - Tiny Bash script to print basic system"
  echo "information. See: https://github.com/rnazmo/proper7y"

  echo "============================================================"

  print_date
  print_virtualization
  print_chassis
  print_cpu_arch
  print_os_name
  print_os_version

  # Only display kernel version on Linux.
  # macOS and other Unix-like systems have kernel versions with different semantics,
  # so we exclude them to avoid confusion.
  if [[ "$UNAME_CACHE_KERNEL_NAME" == "linux" ]]; then
    print_kernel_version
  fi

  print_current_shell
  print_bash_version

  case "$CURRENT_SHELL_ID" in
  'bash')
    # Do nothing
    ;;
  'zsh')
    print_zsh_version
    ;;
  esac

  echo "============================================================"
}

# -------------------------------------------------------------------

# What is this?:
#     Caches the output of uname in global variables for performance.
#
# NOTE: We call uname three times with separate flags instead of parsing
# a combined output. This avoids relying on fixed field positions in the
# combined output, which could break if nodename contains spaces.
# See ADR-036 for the rationale.
cache_uname() {
  UNAME_CACHE_KERNEL_NAME="$(uname -s)"
  UNAME_CACHE_MACHINE="$(uname -m)"
  UNAME_CACHE_RELEASE="$(uname -r)"
  readonly UNAME_CACHE_KERNEL_NAME
  readonly UNAME_CACHE_MACHINE
  readonly UNAME_CACHE_RELEASE
}

# Identify the OS family (e.g. arch-based, debian-based) and store it in OS_FAMILY_ID.
# Exits immediately if the OS family is not in SUPPORTED_OS_FAMILY_IDS.
#
# NOTE:
#   Must be called after cache_uname().
#
# Ref:
#   https://stackoverflow.com/a/17072017
#   https://stackoverflow.com/a/18434831
#   https://github.com/dylanaraps/neofetch/issues/433#issue-188679046
#   http://linuxmafia.com/faq/Admin/release-files.html
identify_os_family_id() {
  case "$UNAME_CACHE_KERNEL_NAME" in
  'linux')
    if [[ -f /etc/arch-release ]]; then
      OS_FAMILY_ID="arch-based"
    elif [[ -f /etc/debian_version ]]; then
      # /etc/debian_version exists on both Debian and Ubuntu.
      # Ubuntu-specific identification is handled later in identify_os_id()
      # by checking /etc/lsb-release.
      OS_FAMILY_ID="debian-based"
    else
      # OS_FAMILY_ID="linux-based"
      OS_FAMILY_ID="Unknown"
    fi
    ;;
  'darwin') OS_FAMILY_ID="darwin-based" ;;
  # 'freebsd') OS_FAMILY_ID="freebsd-based" ;;
  # 'openbsd') OS_FAMILY_ID="openbsd-based" ;;
  # 'netbsd') OS_FAMILY_ID="netbsd-based" ;;
  # cygwin* | msys* | mingw*) OS_FAMILY_ID="windows-based" ;;
  *) OS_FAMILY_ID="Unknown" ;;
  esac

  readonly OS_FAMILY_ID

  # Check if the UNAME_CACHE_KERNEL_NAME value is in SUPPORTED_OS_FAMILY_IDS
  if ! is_supported "$OS_FAMILY_ID" "${SUPPORTED_OS_FAMILY_IDS[@]}"; then
    log_err "This script does not support the OS family: ${OS_FAMILY_ID}"
    # Use 'exit' here (not 'return') because proper7y is a top-level script,
    # not a library. When identification fails, there is nothing useful to do.
    # See ADR-010 for the exit/return policy.
    exit 1
  fi
}

# Identify the specific OS (e.g. ubuntu, archlinux) and store it in OS_ID.
# Exits immediately if the OS is not in SUPPORTED_OS_IDS.
#
# NOTE:
#   Must be called after identify_os_family_id().
identify_os_id() {
  case "$OS_FAMILY_ID" in
  'arch-based')
    if [[ -f /etc/manjaro-release ]]; then
      OS_ID="manjaro"
    elif [[ -f /etc/os-release ]] && grep -qE '^ID=("endeavouros"|endeavouros)$' /etc/os-release; then
      OS_ID="endeavouros"
    elif [[ -f /etc/arch-release ]]; then
      OS_ID="archlinux"
    else
      OS_ID="unknown"
    fi
    ;;
  'debian-based')
    if [[ -f /etc/kali-version ]]; then
      OS_ID="kali"
    elif [[ -f /etc/lsb-release ]] && grep -q "DISTRIB_ID=Ubuntu" /etc/lsb-release; then
      OS_ID="ubuntu"
    elif [[ -f /etc/debian_version ]]; then
      OS_ID="debian"
    else
      OS_ID="unknown"
    fi
    ;;
  'darwin-based') OS_ID="macos" ;;
  # 'freebsd-based') OS_ID="freebsd" ;;
  # 'openbsd-based') OS_ID="openbsd" ;;
  # 'netbsd-based') OS_ID="netbsd" ;;
  # 'windows-based') OS_ID="windows11" ;;
  *) OS_ID="unknown" ;;
  esac

  readonly OS_ID

  # Check if the OS_ID value is in SUPPORTED_OS_IDS
  if ! is_supported "$OS_ID" "${SUPPORTED_OS_IDS[@]}"; then
    log_err "This script does not support the OS ID: ${OS_ID}"
    # See identify_os_family_id() and ADR-010.
    exit 1
  fi
}

# Detect the virtualization environment and store it in VIRTUALIZATION_ID.
# On Linux, tries systemd-detect-virt first, then falls back to hostnamectl.
# On macOS (darwin), delegates to identify_virtualization_id_for_darwin().
# Exits immediately if the result is not in SUPPORTED_VIRTUALIZATION_IDS.
identify_virtualization_id() {
  if [[ "$UNAME_CACHE_KERNEL_NAME" == "darwin" ]]; then
    identify_virtualization_id_for_darwin
    readonly VIRTUALIZATION_ID
    return 0
  fi

  if command -v systemd-detect-virt &>/dev/null; then
    case "$(systemd-detect-virt)" in
    'oracle' | 'virtualbox') VIRTUALIZATION_ID="virtualbox" ;;
    'vmware') VIRTUALIZATION_ID="vmware" ;;
    'microsoft') VIRTUALIZATION_ID="microsoft" ;;
    'docker') VIRTUALIZATION_ID="docker" ;;
    'wsl') VIRTUALIZATION_ID="wsl" ;;
    'none') VIRTUALIZATION_ID="physical" ;;
    *) VIRTUALIZATION_ID="unknown" ;;
    esac
  elif command -v hostnamectl &>/dev/null; then
    local hostnamectl_output
    hostnamectl_output="$(hostnamectl status 2>/dev/null)" || true
    if [[ "$hostnamectl_output" == *"Virtualization:"* ]]; then
      local virt_raw
      virt_raw="$(echo "$hostnamectl_output" | grep "Virtualization:" | sed -e "s/ *Virtualization: //" | tr '[:upper:]' '[:lower:]')"
      case "$virt_raw" in
      'oracle' | 'virtualbox') VIRTUALIZATION_ID="virtualbox" ;;
      'vmware') VIRTUALIZATION_ID="vmware" ;;
      'microsoft') VIRTUALIZATION_ID="microsoft" ;;
      'docker') VIRTUALIZATION_ID="docker" ;;
      'wsl') VIRTUALIZATION_ID="wsl" ;;
      *) VIRTUALIZATION_ID="unknown" ;;
      esac
    else
      VIRTUALIZATION_ID="physical"
    fi
  else
    VIRTUALIZATION_ID="unknown"
  fi

  readonly VIRTUALIZATION_ID

  # Check if the VIRTUALIZATION_ID value is in SUPPORTED_VIRTUALIZATION_IDS
  if ! is_supported "$VIRTUALIZATION_ID" "${SUPPORTED_VIRTUALIZATION_IDS[@]}"; then
    log_err "This script does not support the VIRTUALIZATION_ID: ${VIRTUALIZATION_ID}"
    if command -v systemd-detect-virt &>/dev/null; then
      log_debug "systemd-detect-virt: $(systemd-detect-virt)"
    fi
    # See identify_os_family_id() and ADR-010.
    exit 1
  fi
}

# Detect virtualization on macOS (darwin) by using multiple signals.
# Strategy:
#   1) VM-positive signals first (strong evidence):
#      - kern.hv_vmm_present=1
#      - known VM strings in ioreg output
#   2) Physical-leaning signals second:
#      - kern.hv_vmm_present=0
#      - no VM marker in ioreg output
#   3) Otherwise: unknown
identify_virtualization_id_for_darwin() {
  local hv_vmm_present=""
  if command -v sysctl &>/dev/null; then
    hv_vmm_present="$(sysctl -n kern.hv_vmm_present 2>/dev/null || true)"
  fi

  local ioreg_output=""
  if command -v ioreg &>/dev/null; then
    ioreg_output="$(ioreg -a -l 2>/dev/null || true)"
  fi

  if [[ "$hv_vmm_present" == "1" ]]; then
    VIRTUALIZATION_ID="applehv"
    return 0
  fi

  # Known virtualization markers seen on macOS VMs/providers.
  if echo "$ioreg_output" | grep -iqE 'vmware|virtualbox|parallels|qemu|virtual machine|virtualmac'; then
    if echo "$ioreg_output" | grep -iq 'vmware'; then
      VIRTUALIZATION_ID="vmware"
    elif echo "$ioreg_output" | grep -iq 'virtualbox'; then
      VIRTUALIZATION_ID="virtualbox"
    else
      VIRTUALIZATION_ID="generic-vm"
    fi
    return 0
  fi

  # Physical-leaning fallback:
  # hv_vmm_present=0 is not a strict proof of physical hardware, but with
  # no VM marker in ioreg we treat it as physical for practical reporting.
  if [[ "$hv_vmm_present" == "0" ]]; then
    VIRTUALIZATION_ID="physical"
    return 0
  fi

  VIRTUALIZATION_ID="unknown"
}

# Identify the chassis type (device type) and store it in CHASSIS_ID.
#
# Unlike other identify_*() functions, this function does NOT call exit
# on unknown values. Chassis type is best-effort information: if the type
# cannot be determined (e.g. hostnamectl is absent, or an unrecognized
# chassis string is returned), CHASSIS_ID is set to "unknown" and
# print_chassis() will display it gracefully. Exiting here would be
# too strict for information that is non-critical. (Ref: ADR-027)
#
# Ref: https://www.freedesktop.org/software/systemd/man/latest/machine-info.html
identify_chassis_id() {
  # Virtual environments don't have a meaningful chassis type.
  # TODO: Allow CHASSIS_ID="vm" or "container"
  #       if VIRTUALIZATION_ID indicates a known VM/container type?
  if [[ "$VIRTUALIZATION_ID" != "physical" ]]; then
    CHASSIS_ID="n/a"
    readonly CHASSIS_ID
    return 0
  fi

  case "$UNAME_CACHE_KERNEL_NAME" in
  "linux")
    if command -v hostnamectl &>/dev/null; then
      local -r hostnamectl_chassis_row="$(hostnamectl status | grep 'Chassis:')"
      if [[ "$hostnamectl_chassis_row" == *"desktop"* ]]; then
        CHASSIS_ID="desktop"
      elif [[ "$hostnamectl_chassis_row" == *"laptop"* ]]; then
        CHASSIS_ID="laptop"
      elif [[ "$hostnamectl_chassis_row" == *"server"* ]]; then
        CHASSIS_ID="server"
      elif [[ "$hostnamectl_chassis_row" == *"tablet"* ]]; then
        CHASSIS_ID="tablet"
      elif [[ "$hostnamectl_chassis_row" == *"handset"* ]]; then
        CHASSIS_ID="handset"
      elif [[ "$hostnamectl_chassis_row" == *"watch"* ]]; then
        CHASSIS_ID="watch"
      elif [[ "$hostnamectl_chassis_row" == *"embedded"* ]]; then
        CHASSIS_ID="embedded"
      else
        CHASSIS_ID="unknown"
      fi
    else
      CHASSIS_ID="unknown"
    fi
    ;;
  "darwin")
    # TODO: Implement macOS chassis detection using system_profiler SPHardwareDataType
    #   Approach idea:
    #     if system_profiler SPHardwareDataType | grep -q "Model Name.*MacBook"; then
    #       CHASSIS="Laptop"
    #     elif system_profiler SPHardwareDataType | grep -q "Model Name.*Mac mini\|iMac\|Mac Pro"; then
    #       CHASSIS="Desktop"
    #     fi
    CHASSIS_ID="unknown"
    ;;
  *)
    CHASSIS_ID="unknown"
    ;;
  esac

  readonly CHASSIS_ID

  # Check if the CHASSIS_ID value is in SUPPORTED_CHASSIS_IDS
  if ! is_supported "$CHASSIS_ID" "${SUPPORTED_CHASSIS_IDS[@]}"; then
    log_err "This script does not support the CHASSIS_ID: ${CHASSIS_ID}"
    # See identify_os_family_id() and ADR-010.
    exit 1
  fi
}

# Identify the shell that invoked this script by walking up the process tree.
#
# Strategy:
#   Starting from $PPID, repeatedly look up the parent process name via 'ps'
#   until a known shell (bash, zsh) is found or the tree is exhausted.
#   If no known shell is found, CURRENT_SHELL_ID is set to "unknown".
#
# NOTE:
#   This approach is best-effort. It works reliably in common cases (direct
#   invocation from bash/zsh, invocation via make, invocation inside tmux),
#   but may return "unknown" in unusual execution contexts such as deeply
#   nested process trees or exotic CI environments. This is acceptable by
#   design. See ADR-028.
#
# NOTE:
#   '(( depth++ )) || true' is required because in Bash with 'set -e',
#   an arithmetic expression that evaluates to 0 (i.e. false) causes the
#   script to exit. When depth is 0, '(( depth++ ))' evaluates to 0 (the
#   value before increment), which would trigger 'set -e'. '|| true' prevents
#   this. See ADR-028.
identify_current_shell_id() {
  local pid="$PPID"
  local cmd
  local -i depth=0
  local -ri MAX_DEPTH=10
  local found=false

  while [[ $depth -lt $MAX_DEPTH ]]; do
    cmd="$(ps -o comm= -p "$pid" 2>/dev/null)" || break
    cmd="${cmd// /}" # trim whitespace

    case "$cmd" in
    *bash*)
      CURRENT_SHELL_ID="bash"
      found=true
      break
      ;;
    *zsh*)
      CURRENT_SHELL_ID="zsh"
      found=true
      break
      ;;
    esac

    # Walk up to the parent process
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null)" || break
    pid="${pid// /}" # trim whitespace
    [[ -z "$pid" || "$pid" == "0" || "$pid" == "1" ]] && break

    ((depth++)) || true
  done

  if [[ "$found" == false ]]; then
    if [[ $depth -eq $MAX_DEPTH ]]; then
      log_debug "Process tree depth limit ($MAX_DEPTH) reached; last pid checked was ${pid}"
    fi
    CURRENT_SHELL_ID="unknown"
  fi
  readonly CURRENT_SHELL_ID

  # Check if the CURRENT_SHELL_ID value is in SUPPORTED_SHELL_IDS
  if ! is_supported "$CURRENT_SHELL_ID" "${SUPPORTED_SHELL_IDS[@]}"; then
    log_err "This script does not support the CURRENT_SHELL_ID: ${CURRENT_SHELL_ID}"
    # See identify_os_family_id() and ADR-010.
    exit 1
  fi
}

# -------------------------------------------------------------------

print_date() {
  local -r CURRENT_DATE="$(date '+%Y-%m-%d')"
  print_row "CURRENT DATE" "$CURRENT_DATE"
}

print_os_name() {
  local -r OS_NAME="${OS_NAMES[$OS_ID]}"
  print_row "OS NAME" "$OS_NAME"
}

print_os_version() {
  local OS_VERSION="Unknown"

  case "$UNAME_CACHE_KERNEL_NAME" in
  "linux")
    # Use /etc/os-release instead of `lsb_release` to get the OS version.
    # `lsb_release` is not available in some minimal environments (e.g. Docker minimal images),
    # while /etc/os-release is part of the systemd standard and is widely available
    # on modern Linux distributions.
    #
    # Ref:
    #   https://stackoverflow.com/a/53015255
    #   https://exlight.net/linux/cmd/lsb_release/index.html
    #   https://www.freedesktop.org/software/systemd/man/latest/os-release.html
    if [[ -f /etc/os-release ]]; then
      # Extract the value of VERSION_ID from /etc/os-release.
      #
      # Example lines in /etc/os-release:
      #   VERSION_ID="22.04"   <- Ubuntu
      #   VERSION_ID=12        <- Debian (no quotes)
      #
      # - `grep '^VERSION_ID='` : Find the line that starts with VERSION_ID=.
      #                           The ^ anchor prevents accidental matches on lines like
      #                           # OLD_VERSION_ID="20.04" (commented out lines, etc.)
      # - `cut -d= -f2`         : Extract the value after the '=' sign.
      # - `tr -d '"'`           : Remove surrounding double quotes if present.
      #                           Some distros quote the value (e.g. "22.04"), others don't (e.g. 12).
      OS_VERSION=$(grep '^VERSION_ID=' /etc/os-release | cut -d= -f2 | tr -d '"') || true

      # If VERSION_ID is not found, check for BUILD_ID=rolling (for rolling release distributions).
      if [[ -z "$OS_VERSION" ]]; then
        if grep -q '^BUILD_ID=rolling' /etc/os-release; then
          OS_VERSION="Rolling Release"
        fi
      fi
    fi
    # If /etc/os-release does not exist, OS_VERSION remains "Unknown" (set at the top of this function).
    ;;
  "darwin")
    OS_VERSION=$(sw_vers -productVersion)
    ;;
  esac

  print_row "OS VERSION" "$OS_VERSION"
}

print_kernel_version() {
  # UNAME_CACHE_RELEASE is guaranteed to be set by cache_uname().
  # If cache_uname() fails, the script exits immediately due to 'set -e'.
  local -r KERNEL_VERSION="$UNAME_CACHE_RELEASE"
  print_row "KERNEL VERSION" "$KERNEL_VERSION"
}

print_cpu_arch() {
  # No fallback value (e.g. "Unknown") is needed here.
  # UNAME_CACHE_MACHINE is guaranteed to be set by the time this function
  # is called, because init() always calls cache_uname() first.
  # If cache_uname() fails, the script exits immediately due to 'set -e'.
  local -r CPU_ARCH="$UNAME_CACHE_MACHINE"
  print_row "CPU ARCH" "$CPU_ARCH"
}

print_virtualization() {
  local -r VIRTUALIZATION="${VIRTUALIZATION_NAMES[$VIRTUALIZATION_ID]:-Unknown}"
  print_row "VIRTUALIZATION" "$VIRTUALIZATION"
}

print_chassis() {
  local -r CHASSIS="${CHASSIS_NAMES[$CHASSIS_ID]:-Unknown}"
  print_row "CHASSIS" "$CHASSIS"
}

print_current_shell() {
  local -r CURRENT_SHELL="${SHELL_NAMES[$CURRENT_SHELL_ID]:-Unknown}"
  print_row "CURRENT SHELL" "$CURRENT_SHELL"
}

print_bash_version() {
  # NOTE: Avoid using BASH_VERSION here as it is a Bash built-in variable.
  local -r BASH_VERSION_STR="${BASH_VERSINFO[0]:-0}.${BASH_VERSINFO[1]:-0}.${BASH_VERSINFO[2]:-0}"
  print_row "BASH VERSION" "$BASH_VERSION_STR"
}

print_zsh_version() {
  local ZSH_VERSION="Unknown"
  local -r CMDNAME="zsh"

  if command -v "$CMDNAME" &>/dev/null; then
    # Extract only the version number from `zsh --version` output.
    # Example input : "zsh 5.9 (x86_64-pc-linux-gnu)"
    # Example output: "5.9"
    ZSH_VERSION=$(zsh --version | sed -e "s/zsh //" -e "s/ (.*//")
  else
    ZSH_VERSION="(Not Found)"
  fi

  print_row "ZSH VERSION" "$ZSH_VERSION"
}

# -------------------------------------------------------------------

# Check if a given value is contained in a given array (exact match).
#
# Usage:
#   is_supported <value> <array_elements...>
#
# Example:
#   is_supported "$OS_ID" "${SUPPORTED_OS_IDS[@]}"
#
is_supported() {
  local -r TARGET="$1"
  shift
  local ELEMENT
  for ELEMENT in "$@"; do
    if [[ "$ELEMENT" == "$TARGET" ]]; then
      return 0
    fi
  done
  return 1
}

# Pad right of a given string with spaces.
#
# TODO: Does this support only ASCII and UTF-8?
#
# Example Usage:
#   PADDED_HELLO="pad_with_spaces 'hello'"
#
pad_with_spaces() {
  local -r RAW="$1"
  local -r LENGTH="14"
  printf "%-*s" "$LENGTH" "$RAW"
}

# Print a row in format using given ROW_NAME and ROW_VALUE.
#
# Example Usage:
#   print_row "OS NAME" "Kali GNU/Linux Rolling"
#
print_row() {
  local -r ROW_NAME="$1"
  local -r ROW_VALUE="$2"
  local -r ROW_NAME_PADDED="$(pad_with_spaces "$ROW_NAME")"

  echo "${ROW_NAME_PADDED}: ${ROW_VALUE}"
}

log_debug() {
  local -r PREFIX="DEBUG:"
  echo "$PREFIX $1"
}

log_err() {
  local -r PREFIX="ERROR:"
  echo "$PREFIX $1" >&2
}

